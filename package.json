{
  "name": "finance-academy",
  "version": "1.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "quality:files": "node scripts/check-file-sizes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "expo:check": "expo-doctor",
    "build": "expo export --platform web --output-dir dist",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run quality:files && npm run typecheck && npm run expo:check && npm test && npm run build && npm run audit",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@sentry/node": "^10.73.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.19",
    "expo-navigation-bar": "~57.0.2",
    "hono": "^4.13.5",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "10.9.1",
    "eslint-config-expo": "^57.0.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "globals": "17.12.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "browserslist": "4.28.8",
    "shell-quote": "1.10.0",
    "query-string": "9.5.1",
    "uuid": "11.1.1",
    "ws@7.0.0 - 7.5.10": "7.5.13"
  },
  "private": true
}
