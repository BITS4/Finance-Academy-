# Mobile client: URL of the included AI proxy. No provider secret belongs in Expo.
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:8787

# Server-only Anthropic credential. Leave empty to use deterministic offline assessments.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Server runtime and observability
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
